<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>YinYanMusic.Scanner</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="TagLibSharp" />
		<PackageReference Include="z440.atl.core" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\YinYanMusic.Core\YinYanMusic.Core.csproj" />
		<ProjectReference Include="..\YinYanMusic.Data\YinYanMusic.Data.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
		<None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Development.json')" />
	</ItemGroup>

</Project>
