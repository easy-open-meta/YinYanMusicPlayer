<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>YinYanMusic.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>音言音乐</ApplicationTitle>
		<ApplicationId>com.yinyan.music</ApplicationId>
		<ApplicationDisplayVersion>2.2.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- NuGet 还原要求 PackageVersion 在所有目标框架下取值一致：
		     Android/iOS 等工作负载会把 $(Version) 设为 $(ApplicationDisplayVersion)，
		     而 Windows 侧依赖 microsoft.maui.core 的 WinUI.targets 才做同样映射，
		     首次还原（包目标文件尚未生成）时 Windows 会落到默认值 1.0.0，从而触发 NU1105。
		     这里显式固定 PackageVersion，保证多目标还原时唯一。 -->
		<PackageVersion>$(ApplicationDisplayVersion)</PackageVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- 跨平台求值放行：本项目多目标（android + windows），在非 Windows 主机上
		     （如 CI 的 Linux APK runner）执行 `dotnet restore YinYanMusic.slnx` 时，
		     Windows TFM 需要显式开启才能被求值/还原，否则直接报
		     NETSDK1100: To build a project targeting Windows on this operating system,
		     set the EnableWindowsTargeting property to true.
		     ⚠️ 这只让「还原/求值」通过，**不代表能在 Linux 上打出 Windows 包** ——
		     WinUI 3 的 XAML 编译器与打包工具只能在 Windows 上跑，
		     Windows 产物走本机的 installer\build-client-installer.ps1。 -->
		<EnableWindowsTargeting Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsTargeting>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\icon.svg" ForegroundFile="Resources\AppIcon\icon.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<!-- 首页头部 logo：源图是 1092x1103 的描摹矢量图，按 1x 88 生成各密度位图（显示尺寸 44） -->
		<MauiImage Update="Resources\Images\logo.svg" Resize="True" BaseSize="88,88" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>

		<PackageReference Include="CommunityToolkit.Maui.MediaElement" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" />
		<PackageReference Include="Xamarin.AndroidX.Media" Condition="'$(TargetFramework)' == 'net10.0-android'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\YinYanMusic.Core\YinYanMusic.Core.csproj" />
	</ItemGroup>

</Project>
