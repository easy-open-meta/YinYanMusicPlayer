<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:YinYanMusic.App"
             xmlns:converters="clr-namespace:YinYanMusic.App.Converters"
             x:Class="YinYanMusic.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary>
                    <converters:StringNotEmptyConverter x:Key="StringNotEmpty"/>
                    <converters:SecondsToTimeConverter x:Key="SecondsToTime"/>
                    <converters:BoolToPlayPauseConverter x:Key="BoolToPlayPause"/>
                    <converters:InverseBoolConverter x:Key="InverseBool"/>
                    <converters:CollectedTextConverter x:Key="CollectedText"/>
                    <converters:AbsoluteUrlConverter x:Key="AbsoluteUrl"/>

                    <Color x:Key="PageBackground">#F6F6F9</Color>
                    <Color x:Key="NowPlayingBackground">#1D1B2E</Color>
                    <Color x:Key="CardBackground">#FFFFFF</Color>
                    <Color x:Key="CardBorder">#E4E4EC</Color>
                    <Color x:Key="Danger">#E5484D</Color>
                    <Color x:Key="Gray300">#C4C4CC</Color>
                    <Color x:Key="Gray400">#A0A0AB</Color>
                    <Color x:Key="Gray500">#7C7C8A</Color>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
