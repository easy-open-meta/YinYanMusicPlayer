<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:YinYanMusic.Core.Dtos;assembly=YinYanMusic.Core"
             xmlns:behaviors="clr-namespace:YinYanMusic.App.Behaviors"
             x:Class="YinYanMusic.App.Views.ZonePage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}"
             Title="专区">

    <Grid RowDefinitions="Auto,*">

        <!-- 分区头部：全宽色块（角半径 0），下缘投影画在内容之上；
             底色/名称/宣传语/图标全部来自 Categories 数据，导航查询串带入 -->
        <Border Grid.Row="0" Style="{StaticResource ShadowTile}" StrokeShape="Rectangle" Padding="16,8,20,20"
                BackgroundColor="{Binding ColorHex}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                <Button Grid.Row="0" FontFamily="MaterialIcons" Text="&#xE5C4;" Command="{Binding BackCommand}"
                        BackgroundColor="Transparent" TextColor="White" HorizontalOptions="Start"
                        Padding="0" FontSize="24" WidthRequest="40" HeightRequest="40"/>
                <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="4,6,0,0">
                    <Label FontFamily="MaterialIcons" Text="{Binding IconGlyph}" FontSize="22" TextColor="White" VerticalOptions="Center"/>
                    <Label Text="{Binding Name}" FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Row="2" Text="{Binding Slogan}" FontSize="13" TextColor="White" Opacity="0.9"
                       Margin="6,0,0,0" LineBreakMode="TailTruncation" MaxLines="1"
                       IsVisible="{Binding Slogan, Converter={StaticResource StringNotEmpty}}"/>
            </Grid>
        </Border>

        <!-- 分区内容：歌曲 + 公开歌单，两段一起滚（整页只有一个滚动条）。
             ⚠️ 这里刻意用 ScrollView + BindableLayout，而不是 CollectionView：
             垂直 CollectionView 套在垂直 ScrollView 里，空列表 + EmptyView 在 Android 上会陷入
             循环测量（页面卡死转圈）—— 本文件早先就是踩了这个坑才改成"单列表自滚动"的。
             BindableLayout 只把条目铺进布局、不参与滚动，没有这个问题；两段数据量都很小
             （歌曲 30 / 歌单 50），不需要虚拟化。 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0" Padding="0,8,0,24">

                <!-- ① 该分区的歌曲（服务端按播放量倒序 = 热门优先）。
                     是否出现由分区的内容类型决定（both / songs），见 ZoneViewModel.ShowSongs -->
                <Label Text="歌曲" FontSize="16" FontAttributes="Bold" Margin="16,4,16,4"
                       IsVisible="{Binding ShowSongs}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Songs}" IsVisible="{Binding ShowSongs}">
                    <BindableLayout.EmptyView>
                        <Label Text="该专区还没有歌曲" TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" Padding="0,32"/>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:SongDto">
                            <Grid Padding="16,10" ColumnDefinitions="36,*,Auto,Auto" ColumnSpacing="10">
                                <Grid.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.PlaySongCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="Scale" Value="0.97"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Frame Grid.Column="0" CornerRadius="4" Padding="0" IsClippedToBounds="True" HeightRequest="32" WidthRequest="32" BackgroundColor="{StaticResource Gray300}" HorizontalOptions="Center" InputTransparent="True">
                                    <Image Source="{Binding CoverUrl, Converter={StaticResource AbsoluteUrl}}" Aspect="AspectFill"/>
                                </Frame>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ArtistsDisplay}" FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding DurationSeconds, Converter={StaticResource SecondsToTime}}"
                                       FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center"/>
                                <Button Grid.Column="3" FontFamily="MaterialIcons" Text="&#xE5D4;" Clicked="OnMoreClicked"
                                        CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{StaticResource Gray500}"
                                        FontSize="16" Padding="0" WidthRequest="30" HeightRequest="30"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ② 该分区下的公开歌单（是否出现由内容类型决定：both / playlists） -->
                <Label Text="歌单" FontSize="16" FontAttributes="Bold" Margin="16,18,16,4"
                       IsVisible="{Binding ShowPlaylists}"/>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Playlists}" IsVisible="{Binding ShowPlaylists}">
                    <BindableLayout.EmptyView>
                        <Label Text="该专区还没有公开歌单" TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" Padding="0,32"/>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtos:PlaylistDto">
                            <Grid Padding="16,8" ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                <Grid.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenPlaylistCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="Scale" Value="0.97"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <!-- 封面：无图回退到歌单图标占位 -->
                                <Grid Grid.Column="0" HeightRequest="56" WidthRequest="56">
                                    <Frame CornerRadius="8" Padding="0" IsClippedToBounds="True" HeightRequest="56" WidthRequest="56"
                                           BackgroundColor="{DynamicResource PrimarySoft}">
                                        <Label FontFamily="MaterialIcons" Text="&#xE03D;" FontSize="22"
                                               TextColor="{DynamicResource Accent}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>
                                    <Frame CornerRadius="8" Padding="0" IsClippedToBounds="True" HeightRequest="56" WidthRequest="56"
                                           BackgroundColor="Transparent"
                                           IsVisible="{Binding CoverUrl, Converter={StaticResource StringNotEmpty}}">
                                        <Image Source="{Binding CoverUrl, Converter={StaticResource AbsoluteUrl}}" Aspect="AspectFill"/>
                                    </Frame>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="15" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding OwnerName}" FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding TrackCount, StringFormat='{0} 首'}"
                                       FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 转菊花：叠在内容之上居中（放在 ScrollView 之外，滚动时不跟着跑） -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{DynamicResource Accent}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
    </Grid>
</ContentPage>
