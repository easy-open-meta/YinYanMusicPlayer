<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YinYanMusic.App.Views.ChangePasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="8">

        <Grid Grid.Row="0" ColumnDefinitions="40,*,40" VerticalOptions="Center">
            <Button Grid.Column="0" FontFamily="MaterialIcons" Text="&#xE5C4;" Command="{Binding BackCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource Accent}"
                    Padding="0" FontSize="24" WidthRequest="40" HeightRequest="40"/>
            <Label Grid.Column="1" Text="修改密码" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="0,4,0,20">

                <Border Style="{StaticResource SurfaceCard}" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="设置新密码" FontSize="15" FontAttributes="Bold"/>
                        <Label Text="修改成功后所有设备都需要用新密码重新登录。" FontSize="11"
                               TextColor="{StaticResource Gray500}"/>

                        <Entry Text="{Binding OldPassword}" Placeholder="当前密码" IsPassword="True" FontSize="15"/>
                        <Entry Text="{Binding NewPassword}" Placeholder="新密码（至少 6 位）" IsPassword="True" FontSize="15"/>
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="确认新密码" IsPassword="True" FontSize="15"/>

                        <Button Text="确认修改" Command="{Binding SubmitCommand}" FontSize="15"
                                BackgroundColor="{DynamicResource Primary}" TextColor="{DynamicResource OnPrimary}"
                                CornerRadius="20" HeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding StatusMessage}" FontSize="13" HorizontalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Danger}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="False">
                            <Setter Property="TextColor" Value="{StaticResource Gray500}"/>
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" IsVisible="{Binding IsBusy}" BackgroundColor="#40000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource Accent}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
