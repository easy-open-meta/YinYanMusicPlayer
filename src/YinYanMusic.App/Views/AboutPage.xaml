<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YinYanMusic.App.Views.AboutPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="8">

        <Grid Grid.Row="0" ColumnDefinitions="40,*,40" VerticalOptions="Center">
            <Button Grid.Column="0" FontFamily="MaterialIcons" Text="&#xE5C4;" Command="{Binding BackCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource Accent}"
                    Padding="0" FontSize="24" WidthRequest="40" HeightRequest="40"/>
            <Label Grid.Column="1" Text="关于" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="24,20" VerticalOptions="Center">

                <!-- 应用 Logo（V2.12）：换成真正的品牌 logo（与首页头部同一个素材，88×88 基准），
                     替代原来的「圆形底色 + 音符」MaterialIcons 占位。
                     ⚠️ 引用必须用 .png：源文件是 Resources/Images/logo.svg，MAUI 构建时转成 PNG，
                     引用 .svg 会在运行时解析不到（HomeView 有同一条注释）。 -->
                <Image Source="logo.png" WidthRequest="88" HeightRequest="88"
                       HorizontalOptions="Center"/>

                <Label Text="{Binding AppName}" FontSize="24" FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding Version}" FontSize="16" TextColor="{DynamicResource Accent}"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding Build}" FontSize="12" TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource CardBorder}" Margin="0,8"/>

                <Label Text="{Binding Description}" FontSize="14" LineHeight="1.4"
                       TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center"/>

                <Label Text="{Binding Platform}" FontSize="12" TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" Margin="0,8,0,0"/>
                <Label Text="{Binding BuildDate}" FontSize="12" TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"/>
                <Label Text="{Binding Copyright}" FontSize="12" TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" Margin="0,8,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>