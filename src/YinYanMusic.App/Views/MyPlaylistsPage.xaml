<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:YinYanMusic.Core.Dtos;assembly=YinYanMusic.Core"
             xmlns:behaviors="clr-namespace:YinYanMusic.App.Behaviors"
             x:Class="YinYanMusic.App.Views.MyPlaylistsPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}"
             Title="我的歌单">

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="8">

        <Grid Grid.Row="0" ColumnDefinitions="40,*,40" VerticalOptions="Center">
            <Button Grid.Column="0" FontFamily="MaterialIcons" Text="&#xE5C4;" Command="{Binding BackCommand}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource Accent}"
                    Padding="0" FontSize="24" WidthRequest="40" HeightRequest="40"/>
            <Label Grid.Column="1" Text="我的歌单" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Accent}"/>
                <CollectionView ItemsSource="{Binding Playlists}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="还没有自己的歌单，去「我的」页新建一个吧" TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" Padding="0,60"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:PlaylistDto">
                            <Grid Padding="4,8" ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                                <Grid.Behaviors>
                                    <behaviors:PressFeedbackBehavior />
                                </Grid.Behaviors>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenPlaylistCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="Scale" Value="0.97"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <!-- 封面：无图回退到歌单图标占位 -->
                                <Grid Grid.Column="0" HeightRequest="56" WidthRequest="56">
                                    <Frame CornerRadius="8" Padding="0" IsClippedToBounds="True" HeightRequest="56" WidthRequest="56"
                                           BackgroundColor="{DynamicResource PrimarySoft}">
                                        <Label FontFamily="MaterialIcons" Text="&#xE03D;" FontSize="22"
                                               TextColor="{DynamicResource Accent}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>
                                    <Frame CornerRadius="8" Padding="0" IsClippedToBounds="True" HeightRequest="56" WidthRequest="56"
                                           BackgroundColor="Transparent"
                                           IsVisible="{Binding CoverUrl, Converter={StaticResource StringNotEmpty}}">
                                        <Image Source="{Binding CoverUrl, Converter={StaticResource AbsoluteUrl}}" Aspect="AspectFill"/>
                                    </Frame>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="15" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding TrackCount, StringFormat='{0} 首'}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" FontFamily="MaterialIcons" Text="&#xE5CC;" FontSize="16"
                                       TextColor="{StaticResource Gray500}" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
