<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:YinYanMusic.Core.Dtos;assembly=YinYanMusic.Core"
             x:Class="YinYanMusic.App.Views.NotificationsPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}"
             Title="消息通知">

    <Grid RowDefinitions="Auto,*" Padding="16,12" RowSpacing="8">

        <!-- 顶部：返回 + 标题 + 全部已读。
             ⚠️ 标题单独一层、按**整条宽度**居中：右侧「全部已读」是文字按钮（比图标宽），
             且未读为 0 时会隐藏 —— 若把标题塞进 40,*,Auto 的中间列，它会被右侧宽度挤偏，
             还会随按钮显隐左右跳（CacheManagePage 那种 40,*,40 的写法要求两侧同宽，
             这里右侧放不下文字按钮）。 -->
        <Grid Grid.Row="0">
            <Label Text="{Binding TitleText}" FontSize="20" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <Grid ColumnDefinitions="40,*,Auto" VerticalOptions="Center">
                <Button Grid.Column="0" FontFamily="MaterialIcons" Text="&#xE5C4;" Command="{Binding BackCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource Accent}"
                        Padding="0" FontSize="24" WidthRequest="40" HeightRequest="40"/>
                <Button Grid.Column="2" Text="全部已读" FontSize="14" Padding="8,4"
                        BackgroundColor="Transparent" TextColor="{DynamicResource Accent}"
                        Command="{Binding MarkAllReadCommand}"
                        IsVisible="{Binding HasUnread}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    <!-- 未读数已经跟在标题后面（「消息通知 (3)」），这里不再单独占一行 -->

                    <!-- ⚠️ 卡片列表刻意用 VerticalStackLayout + BindableLayout，**不用 CollectionView**。
                         原因：CollectionView 给条目定位置/尺寸时不把模板根元素的 Margin 算进去 ——
                         2026-09-27 像素级实测（截图纵向扫描）Margin="13,7,13,7" 完全没生效，
                         四张卡片的背景色连成 376px 一片、缝隙为 0，即用户看到的"全都贴在一起"。
                         而 Spacing 是**容器级**属性，必然生效；这也是「我的」页两块卡片列表的写法
                         （那边 SurfaceCard 卡片的间距就是靠它），本页与它保持同一口径。
                         代价是没有 EmptyView 与虚拟化 —— 通知是分页拉取的，量级用不上虚拟化，
                         空态改由 IsEmpty 自己判。 -->
                    <VerticalStackLayout Spacing="18" BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dtos:NotificationDto">
                                <!-- Margin 的左右 13dp 是 SurfaceCard 的投影落点
                                     （Offset 2,4 / Radius 8），与「我的」页卡片同口径；
                                     它落在 StackLayout 里，Margin 是被正常计算的。 -->
                                <Border Style="{StaticResource SurfaceCard}" Padding="16,14" Margin="13,0,13,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                                <!-- 未读红点：Frame 默认带投影和描边，必须显式关掉，否则是白圈不是红点 -->
                                                <Frame Grid.Column="0" CornerRadius="4" Padding="0"
                                                       WidthRequest="8" HeightRequest="8" HasShadow="False"
                                                       BorderColor="Transparent"
                                                       BackgroundColor="{DynamicResource Accent}"
                                                       VerticalOptions="Start" Margin="0,6,0,0"
                                                       IsVisible="{Binding IsRead, Converter={StaticResource InverseBool}}"/>
                                                <Label Grid.Column="1" Text="{Binding Title}" FontSize="15"
                                                       FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                            </Grid>
                                            <Label Text="{Binding Content}" FontSize="13"
                                                   TextColor="{StaticResource Gray500}" LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                                   FontSize="11" TextColor="{StaticResource Gray400}"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" FontFamily="MaterialIcons" Text="&#xE5CC;"
                                               FontSize="18" TextColor="{StaticResource Gray400}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding HasRelatedTarget}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="暂无通知" TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" Padding="0,60" IsVisible="{Binding IsEmpty}"/>

                    <Button Text="加载更多" FontSize="13" Padding="16,8" Margin="0,2,0,8"
                            BackgroundColor="Transparent" TextColor="{DynamicResource Accent}"
                            Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding HasMore}"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
