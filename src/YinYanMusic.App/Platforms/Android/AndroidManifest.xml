<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<!-- V2.6 本地音乐库：读取设备音频。Android 13(API 33) 起用 READ_MEDIA_AUDIO，
	     之前用 READ_EXTERNAL_STORAGE；两个都声明，运行时按系统版本二选一申请
	     （见 AndroidLocalMediaScanner.EnsurePermissionAsync）。
	     maxSdkVersion=32 让 READ_EXTERNAL_STORAGE 在新系统上不参与合并，避免多余授权提示。 -->
	<uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<!-- ⚠️ 明文 HTTP 策略由 ${nscRes} 占位符指向的**网络安全配置文件**决定（csproj 注入）：
	     Debug → @xml/network_security_config_debug（明文全开，真机连局域网/本机后端必需）；
	     其它 → @xml/network_security_config（严格：只走 HTTPS + 少量本地例外）。
	     ⚠️ 这里**不能**用 android:usesCleartextTraffic 来"放开明文"：只要声明了
	        networkSecurityConfig，该属性就会被系统忽略（官方文档明确）。
	     ⚠️ 也不要用 nsc 里的 <debug-overrides>：它只支持 <trust-anchors>，
	        写 <base-config cleartextTrafficPermitted="true"> 是无效配置（2026-09-22 修正）。 -->
	<application android:allowBackup="true" android:icon="@mipmap/icon" android:roundIcon="@mipmap/icon_round" android:supportsRtl="true" android:networkSecurityConfig="${nscRes}" android:enableOnBackInvokedCallback="true">

	</application>
</manifest>
